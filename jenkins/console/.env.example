# 只放变量名与示例值，不放令牌。复制为 .env.local 后修改。
# 是否使用 mock 假数据：
#   未设置 -> `vite`(dev) 默认 true；`vite build`(生产构建) 默认 false，直接走真实 Jenkins
#   true   -> 强制 mock（演示 / 截图：VITE_USE_MOCK=true vite build）
#   false  -> 强制真实 Jenkins（dev 下需要代理到 localhost:18080，并先在该地址登录 Jenkins）
# VITE_USE_MOCK=false
# mock 偶发失败概率（0 = 不失败；截图时可设 0；仅 mock 模式有效）
VITE_MOCK_FAIL_RATE=0.08
# real 模式 Jenkins 基础路径，同源部署（userContent/wealth/）留空
VITE_JENKINS_BASE=
