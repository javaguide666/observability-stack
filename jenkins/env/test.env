# test：k3s。只在这里构建一次，同一个镜像 digest 再晋升到 prod
# 占位值（TODO）：等 Imogen 确认 test 机器 / Harbor 地址后填写，脚本不用改
# 约定：一律写成 VAR="${VAR:-默认值}"，Job 参数 / 外部环境变量优先
ENV_NAME="${ENV_NAME:-test}"
REGISTRY="${REGISTRY:-harbor.test.example.com/wealth}"      # TODO 自建 Harbor 项目地址
K8S_NAMESPACE="${K8S_NAMESPACE:-wealth}"
IMAGE_BUILDER="${IMAGE_BUILDER:-buildctl}"                  # k3s 动态 Pod agent，不挂 docker.sock
BUILDKIT_HOST="${BUILDKIT_HOST:-tcp://buildkitd.ci.svc.cluster.local:1234}"   # TODO buildkitd 地址
DEPLOY_MODE="${DEPLOY_MODE:-kubectl}"                       # 沿用 set image（按 digest）
ALLOWED_MODES="${ALLOWED_MODES:-build-deploy rollback}"
CACHE_ROOT="${CACHE_ROOT:-/cache}"                          # Pod agent 挂载的 PVC：git-cache / m2 都在这里，热缓存
MAVEN_SETTINGS="${MAVEN_SETTINGS:-${WEALTH_CI_ROOT}/maven/settings-aliyun.xml}"   # 上 Nexus 后换 settings-nexus.xml
M2_REPO="${M2_REPO:-${CACHE_ROOT}/m2}"
ALLOW_LOCAL_MOUNT="${ALLOW_LOCAL_MOUNT:-0}"
KUBECONFIG_DOCKER_DESKTOP_REWRITE="${KUBECONFIG_DOCKER_DESKTOP_REWRITE:-0}"
WEALTH_ALL_PARALLEL="${WEALTH_ALL_PARALLEL:-3}"
# 以下由 Jenkinsfile 用 withCredentials 注入，脚本只读环境变量：
#   KUBECONFIG        ← 凭据 ID k3s-test-kubeconfig（TODO）
#   GIT_SSH_KEY_FILE  ← 凭据 ID github-ssh
#   Harbor 推送账号    ← 凭据 ID harbor-test-robot（TODO），写入 ~/.docker/config.json 供 buildctl 使用
DEPLOY_HINT="${DEPLOY_HINT:-在 wealth-freedom 根目录对 test 集群执行 ./deploy/k8s/scripts/deploy.sh test}"
