# prod：云厂商托管 K8S。prod 不构建，只晋升 test 验证过的同一个 digest，由 ArgoCD 手动 Sync 上线
# 占位值（TODO）：等 Imogen 确认云厂商后填写，脚本不用改
# 约定：一律写成 VAR="${VAR:-默认值}"，Job 参数 / 外部环境变量优先
ENV_NAME="${ENV_NAME:-prod}"
REGISTRY="${REGISTRY:-registry.example-cloud.com/wealth}"             # TODO 云厂商镜像服务（ACR/TCR 等），集群走内网拉取
PROMOTE_SOURCE_REGISTRY="${PROMOTE_SOURCE_REGISTRY:-harbor.test.example.com/wealth}"   # TODO 与 test.env 的 REGISTRY 一致
K8S_NAMESPACE="${K8S_NAMESPACE:-wealth}"
IMAGE_BUILDER="${IMAGE_BUILDER:-none}"                               # prod 不构建
DEPLOY_MODE="${DEPLOY_MODE:-gitops}"                                 # Jenkins 只提交 overlays/prod，拿不到 prod 集群凭据
ALLOWED_MODES="${ALLOWED_MODES:-promote rollback}"
GITOPS_REPO_URL="${GITOPS_REPO_URL:-git@github.com:javaguide666/wealth-freedom.git}"
GITOPS_BRANCH="${GITOPS_BRANCH:-main}"
GITOPS_OVERLAY_PATH="${GITOPS_OVERLAY_PATH:-deploy/k8s/overlays}"
CACHE_ROOT="${CACHE_ROOT:-/cache}"
ALLOW_LOCAL_MOUNT="${ALLOW_LOCAL_MOUNT:-0}"
KUBECONFIG_DOCKER_DESKTOP_REWRITE="${KUBECONFIG_DOCKER_DESKTOP_REWRITE:-0}"
WEALTH_ALL_PARALLEL="${WEALTH_ALL_PARALLEL:-3}"
# 以下由 Jenkinsfile 用 withCredentials 注入：
#   GIT_SSH_KEY_FILE   ← 凭据 ID github-ssh（需要对 GITOPS_REPO_URL 有推送权限）
#   两边仓库账号        ← 凭据 ID harbor-test-robot / prod-registry（TODO），供 crane copy 使用
DEPLOY_HINT="${DEPLOY_HINT:-在 ArgoCD 中创建指向 deploy/k8s/overlays/prod 的 Application}"
