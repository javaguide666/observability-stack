# dev：本机 Mac + Docker Desktop K8s，Jenkins 跑在 obs-jenkins 容器里（行为与改造前一致）
# 约定：一律写成 VAR="${VAR:-默认值}"，Job 参数 / 外部环境变量优先，这里只给默认值
ENV_NAME="${ENV_NAME:-dev}"
REGISTRY="${REGISTRY:-}"                         # 空 = Docker Desktop 本机短名镜像，不推送
K8S_NAMESPACE="${K8S_NAMESPACE:-wealth}"
IMAGE_BUILDER="${IMAGE_BUILDER:-docker}"         # 挂载宿主机 docker.sock
DEPLOY_MODE="${DEPLOY_MODE:-kubectl}"
ALLOWED_MODES="${ALLOWED_MODES:-build-deploy rollback}"
CACHE_ROOT="${CACHE_ROOT:-${JENKINS_HOME:-/var/jenkins_home}}"
MAVEN_SETTINGS="${MAVEN_SETTINGS:-${WEALTH_CI_ROOT}/maven/settings-aliyun.xml}"
M2_REPO="${M2_REPO:-${CACHE_ROOT}/.m2/repository}"
ALLOW_LOCAL_MOUNT="${ALLOW_LOCAL_MOUNT:-1}"      # 允许 SOURCE=local-mount
LOCAL_MOUNT_ROOT="${LOCAL_MOUNT_ROOT:-/gitee}"   # 宿主机 ~/gitee 挂进容器的位置
KUBECONFIG_DOCKER_DESKTOP_REWRITE="${KUBECONFIG_DOCKER_DESKTOP_REWRITE:-1}"
WEALTH_ALL_PARALLEL="${WEALTH_ALL_PARALLEL:-1}"  # 全量 Job 打镜像/部署并行度；1 = 串行，日志实时输出
DEPLOY_HINT="${DEPLOY_HINT:-cd ~/gitee/wealth-freedom && ./deploy/k8s/scripts/deploy.sh dev}"
