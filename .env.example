# ============================================================
# observability-stack 环境变量模板。复制为 .env：cp .env.example .env（Windows：copy .env.example .env）。
# 每个 docker-compose.<组件>.yml 单独启动时同样读取本文件；缺省值与此处一致。
# .env 含密码，已被 .gitignore 忽略，不要提交。
# 下面的默认账号是「开发约定」，与 IDEA 配置、wealth-freedom K8s dev secret 对齐；
# 测试/共享环境请自行改下面的密码（Mac/Linux 可用 scripts/init-env.sh --random 生成），并同步 K8s secret。
# 注意：MySQL 的 nacos / admin 账号密码写在 config/mysql/init/01-users.sql 里，改密码需同步改该 SQL。
# ============================================================

# ===== 通用 =====
# 容器名前缀（默认 obs → obs-mysql / obs-redis / obs-nacos ...）。改它可在同一台机器再起一套隔离环境
CONTAINER_PREFIX=obs
# 共享 Docker 网络名
OBS_NETWORK=obs-net
TZ=Asia/Shanghai
# 镜像加速前缀（可选，须以 / 结尾；默认空=直连 Docker Hub）。例：docker.1ms.run/  或  docker.m.daocloud.io/
REGISTRY_MIRROR=
# （可选脚本 scripts/up.sh）等待组件 healthy 的超时秒数
WAIT_TIMEOUT=300

# ===== 数据目录（bind mount，不进 Git；相对路径相对本目录）=====
# MySQL / Redis / Nacos / PostgreSQL / ClickHouse / Jenkins 数据：${DOCKER_DATA_DIR}/<组件>/...
DOCKER_DATA_DIR=./data
# SkyWalking(banyandb) / Prometheus / Grafana / Alloy 数据：${LOCAL_DATA_DIR}/<组件>
LOCAL_DATA_DIR=./data

# ===== 镜像版本（均固定 tag，multi-arch：linux/amd64 + linux/arm64）=====
MYSQL_VERSION=9.7.2
REDIS_VERSION=8.10.1
# 使用 -slim（含 arm64）；x86_64 也可用 v3.2.4
NACOS_VERSION=v3.2.4-slim
POSTGRES_VERSION=18.6-alpine
# 官方验证组合：SkyWalking 10.4.0 + BanyanDB 0.10.0
SW_VERSION=10.4.0
BANYANDB_VERSION=0.10.0
# 日志搬运 qryn（兼容 Loki Push / LogQL，写入 ClickHouse 库 obs_logs）
QRYN_VERSION=3.2.39
LOG_RETENTION_DAYS=7
ALLOY_VERSION=v1.20.1
CLICKHOUSE_VERSION=25.8
CLICKVISUAL_VERSION=1.0.4
GRAFANA_VERSION=13.0.10
PROMETHEUS_VERSION=v3.15.0
NODE_EXPORTER_VERSION=v1.12.1
PROMETHEUS_RETENTION=15d
# Jenkins 镜像本地构建（jenkins/Dockerfile，基于 jenkins/jenkins:lts）
JENKINS_IMAGE=wealth-jenkins:lts-ci

# ===== 宿主端口（冲突时只改这里）=====
MYSQL_PORT=3306
REDIS_PORT=6379
POSTGRES_PORT=5432
NACOS_CONSOLE_PORT=8080
NACOS_PORT=8848
NACOS_GRPC_PORT=9848
NACOS_RAFT_PORT=9849
# SkyWalking UI 默认 18089（容器内 8080），避开 Nacos 控制台 8080
SW_UI_PORT=18089
SW_OAP_GRPC_PORT=11800
SW_OAP_HTTP_PORT=12800
BANYANDB_GRPC_PORT=17912
BANYANDB_HTTP_PORT=17913
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9001
LOKI_PORT=3100
ALLOY_PORT=12345
CLICKVISUAL_PORT=19001
# Grafana 默认 3002：避开 K8s 电商前端 :3000 与 K8s 日志 Grafana :3001
GRAFANA_PORT=3002
PROMETHEUS_PORT=9090
NODE_EXPORTER_PORT=9100
JENKINS_PORT=18080
JENKINS_AGENT_PORT=50000

# ===== Jenkins 宿主挂载（跨机器按需改）=====
DOCKER_SOCK=/var/run/docker.sock
# 留空表示用 ${HOME}/.kube、${HOME}/.ssh、${HOME}/gitee
# JENKINS_KUBE_DIR=
# JENKINS_SSH_DIR=
# JENKINS_WORKSPACE_DIR=

# ===== Nacos JVM =====
NACOS_JVM_XMS=512m
NACOS_JVM_XMX=512m
NACOS_JVM_XMN=256m
SW_OAP_JAVA_OPTS=-Xms512m -Xmx2g -XX:MaxDirectMemorySize=512m

# ===== 凭据（测试/生产务必修改）=====
MYSQL_ROOT_PASSWORD=Admin13278@
# nacos 账号密码：必须与 config/mysql/init/01-users.sql 里 nacos 账号的密码一致（Nacos 用它连库）；
# 该 SQL 只在数据目录为空时执行一次，改密码需同步改 SQL，已有数据需 ALTER USER
MYSQL_NACOS_PASSWORD=Admin13278@
REDIS_PASSWORD=Admin13278@
POSTGRES_USER=admin
POSTGRES_PASSWORD=Admin13278@
POSTGRES_DB=myapp_db
# 必须是 Base64，且解码后原始串长度 >= 32
NACOS_AUTH_TOKEN=VGhpc0lzTXlDdXN0b21TZWNyZXRLZXkwMTIzNDU2Nzg=
NACOS_AUTH_IDENTITY_KEY=nacos_identity
NACOS_AUTH_IDENTITY_VALUE=nacos_value
# Nacos 控制台 admin（账号 nacos）初始密码：nacos-init 一次性幂等创建，已初始化则跳过
NACOS_ADMIN_PASSWORD=NacosAdmin
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
CLICKHOUSE_USER=default
# 不要含冒号；config/clickvisual/docker.toml 的 DSN 写了同一密码，改它需同步
CLICKHOUSE_PASSWORD=Admin13278
