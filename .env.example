# ===== 数据目录（bind mount，不进 Git）=====
DOCKER_DATA_DIR=/Users/eric_brewer/.docker

# ===== 镜像版本（均为 multi-arch：linux/amd64 + linux/arm64，M1 与 x86 通用）=====
MYSQL_VERSION=9.7.2
REDIS_VERSION=8.10.1
# M1/ARM 必须用 -slim；x86_64 可改为 v3.2.4
NACOS_VERSION=v3.2.4-slim
POSTGRES_VERSION=18.6-alpine
JENKINS_VERSION=lts
# 官方验证组合：SkyWalking 10.4.0 + BanyanDB 0.10.0
SW_VERSION=10.4.0
BANYANDB_VERSION=0.10.0
LOKI_VERSION=3.7.7
# Loki 对象存储：RustFS 1.0.0 GA（Apache-2.0）；rc 为 RustFS 官方 S3 命令行客户端，仅用于建 bucket
RUSTFS_VERSION=1.0.0
RUSTFS_RC_VERSION=v0.1.36
CLICKHOUSE_VERSION=25.8
# 以下默认 latest；迁移到测试环境前建议固定成具体版本号（用 docker compose config 查看当前解析出的 tag 后写死）
# GRAFANA_VERSION=12.x.x

# ===== 凭据（测试 / 生产环境务必修改）=====
MYSQL_ROOT_PASSWORD=Admin13278@
MYSQL_NACOS_PASSWORD=Admin13278@
REDIS_PASSWORD=Admin13278@
POSTGRES_USER=admin
POSTGRES_PASSWORD=Admin13278@
POSTGRES_DB=myapp_db
# 必须是 Base64，且解码后原始串长度 >= 32
NACOS_AUTH_TOKEN=VGhpc0lzTXlDdXN0b21TZWNyZXRLZXkwMTIzNDU2Nzg=
NACOS_AUTH_IDENTITY_KEY=nacos_identity
NACOS_AUTH_IDENTITY_VALUE=nacos_value
# RustFS：必填；不能使用默认的 rustfsadmin；Loki 通过同一组账号访问（compose 内映射为 S3_ACCESS_KEY / S3_SECRET_KEY）
RUSTFS_ACCESS_KEY=lokiadmin
RUSTFS_SECRET_KEY=Change-Me-Loki-2026
# Grafana 宿主端口（默认 3002：避开 K8s 电商前端 :3000 与 K8s 日志 Grafana :3001）
GRAFANA_PORT=3002
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=Admin13278
